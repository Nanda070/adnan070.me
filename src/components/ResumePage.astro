---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import ProjectLinks from './ProjectLinks.astro';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import {
  siteMeta,
  resumeCopy,
  homeCopy,
  experienceForResume,
  resumeProjects,
  contacts,
} from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const resume = resumeCopy[locale];
const title = `${resume.title} — ${siteMeta.name}`;
const experience = experienceForResume();
const sideProjects = resumeProjects();
const topContacts = contacts.filter((c) => ['email', 'phone', 'github', 'telegram'].includes(c.id));
---

<Layout locale={locale} title={title} description={resume.summary}>
  <div class="site-frame">
    <Nav locale={locale} />
    <main class="print-resume page-shell flex-1">
      <div class="sheet panel">
        <header class="cv-head">
          <div class="cv-head__row">
            <div>
              <h1 class="cv-name">{siteMeta.name}</h1>
              <p class="cv-role">{homeCopy[locale].role}</p>
            </div>
            <button type="button" class="btn btn--ghost btn--small no-print" id="print-resume">
              {t(locale, 'printResume')}
            </button>
          </div>
          <ul class="cv-contacts">
            {
              topContacts.map((item) => (
                <li>{item.href ? <a href={item.href}>{item.value}</a> : <span>{item.value}</span>}</li>
              ))
            }
            <li>{siteMeta.location[locale]}</li>
          </ul>
        </header>

        <section class="cv-block">
          <h2 class="cv-h2">{t(locale, 'resumeSummary')}</h2>
          <p class="cv-summary">{resume.summary}</p>
        </section>

        <section class="cv-block">
          <h2 class="cv-h2">{t(locale, 'resumeExperience')}</h2>
          <ul class="cv-list">
            {
              experience.map((job) => (
                <li class="cv-item">
                  <div class="cv-item__head">
                    <h3 class="cv-item__name">{job.name}</h3>
                    <p class="cv-item__dates">{job.dates[locale]}</p>
                  </div>
                  <p class="cv-item__role">{job.role[locale]}</p>
                  {job.stack && <p class="cv-item__stack">{job.stack}</p>}
                  <ul class="cv-bullets">
                    {job.bullets[locale].map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  <ProjectLinks project={job} full class="cv-item__links" />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="cv-block">
          <h2 class="cv-h2">{t(locale, 'resumeProjects')}</h2>
          <ul class="cv-list">
            {
              sideProjects.map((project) => (
                <li class="cv-item">
                  <div class="cv-item__head">
                    <h3 class="cv-item__name">{project.name}</h3>
                    <p class="cv-item__dates">{project.dates[locale]}</p>
                  </div>
                  <p class="cv-item__text">{project.summary[locale]}</p>
                  {project.stack && <p class="cv-item__stack">{project.stack}</p>}
                  <ProjectLinks project={project} full class="cv-item__links" />
                </li>
              ))
            }
          </ul>
        </section>

        <div class="cv-cols">
          <section class="cv-block">
            <h2 class="cv-h2">{t(locale, 'resumeSkills')}</h2>
            <dl class="cv-defs">
              {
                resume.skillGroups.map((group) => (
                  <>
                    <dt>{group.name}</dt>
                    <dd>{group.items}</dd>
                  </>
                ))
              }
            </dl>
          </section>

          <section class="cv-block">
            <h2 class="cv-h2">{t(locale, 'resumeLanguages')}</h2>
            <dl class="cv-defs cv-defs--tight">
              {
                resume.languages.map((lang) => (
                  <>
                    <dt>{lang.name}</dt>
                    <dd>{lang.level}</dd>
                  </>
                ))
              }
            </dl>
          </section>
        </div>

        <section class="cv-block">
          <h2 class="cv-h2">{t(locale, 'resumeEducation')}</h2>
          <div class="cv-item__head">
            <h3 class="cv-item__name">{resume.education.school}</h3>
            <p class="cv-item__dates">{resume.education.dates}</p>
          </div>
          <p class="cv-item__text">{resume.education.detail}</p>
        </section>
      </div>
    </main>
    <Footer locale={locale} />
  </div>
</Layout>

<script>
  document.getElementById('print-resume')?.addEventListener('click', () => window.print());
</script>
