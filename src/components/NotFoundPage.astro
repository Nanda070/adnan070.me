---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import type { Locale } from '../i18n/ui';
import { t, withBase } from '../i18n/ui';
import { siteMeta } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const title = `404 — ${siteMeta.name}`;
const home = withBase(import.meta.env.BASE_URL, locale);
---

<Layout locale={locale} title={title} description={t(locale, 'notFoundLead')}>
  <div class="site-frame">
    <Nav locale={locale} />
    <main class="page-shell flex-1">
      <header class="page-head">
        <p class="lost__code">{t(locale, 'notFoundKicker')}</p>
        <h1 class="page-head__title">{t(locale, 'notFoundTitle')}</h1>
        <p class="page-head__lead">{t(locale, 'notFoundLead')}</p>
        <a class="btn btn--primary lost__back" href={home}>{t(locale, 'backHome')}</a>
      </header>
    </main>
    <Footer locale={locale} />
  </div>
</Layout>
