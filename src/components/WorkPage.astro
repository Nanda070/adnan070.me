---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import ProjectLinks from './ProjectLinks.astro';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import { siteMeta, projects } from '../data/site';
import { getLabExtra, labCats, labUi } from '../data/lab';
import type { Project } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const title = `${t(locale, 'navWork')} — ${siteMeta.name}`;
// Same zones as the Robot Lab; Val Qauym is listed first, at the top of the Discord bots group.
const groups = labCats
  .filter(([cat]) => cat !== 'valqauym')
  .map(([cat, label]) => ({
    cat,
    title: label[locale],
    items: projects.filter((p) => {
      const c = getLabExtra(p.id).cat;
      return c === cat || (cat === 'bots' && c === 'valqauym');
    }),
  }))
  .filter((g) => g.items.length > 0);
const pluralRules = new Intl.PluralRules(locale);
const countLabel = (n: number) => labUi[locale].plural[pluralRules.select(n) as 'one' | 'few' | 'many' | 'other'].replace('{n}', String(n));
const chips = (project: Project) =>
  (project.stack ?? '')
    .split(/\s*[,·]\s*/)
    .map((s) => s.trim())
    .filter(Boolean);
---

<Layout locale={locale} title={title} description={t(locale, 'workLead')}>
  <div class="site-frame">
    <Nav locale={locale} />
    <main class="page-shell flex-1">
      <header class="page-head">
        <h1 class="page-head__title">{t(locale, 'navWork')}</h1>
        <p class="page-head__lead">{t(locale, 'workLead')}</p>
      </header>

      {
        groups.map((group) => (
          <section class="section" id={group.cat}>
            <p class="zone-tag">
              {t(locale, 'zoneWord')} · {countLabel(group.items.length)}
            </p>
            <h2 class="section__title">{group.title}</h2>
            <div class="dossier">
              {group.items.map((project) => (
                <details class="entry" open={project.group === 'lead'}>
                  <summary class="entry__bar">
                    <span class="entry__name">
                      {project.name} <small class="entry__big">{getLabExtra(project.id).big}</small>
                    </span>
                    <span class="entry__role">{project.role[locale]}</span>
                    <span class="entry__dates">{project.dates[locale]}</span>
                    <span class="entry__toggle" aria-hidden="true"></span>
                  </summary>
                  <div class="entry__body">
                    <p class="entry__summary">{project.summary[locale]}</p>
                    <ul class="entry__points">
                      {project.bullets[locale].map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                    {chips(project).length > 0 && (
                      <ul class="chips" aria-label={t(locale, 'stackEyebrow')}>
                        {chips(project).map((c) => (
                          <li class="chip">{c}</li>
                        ))}
                      </ul>
                    )}
                    <ProjectLinks project={project} class="entry__links" />
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))
      }
    </main>
    <Footer locale={locale} />
  </div>
</Layout>
