---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import { siteMeta, projectsByGroup } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const title = `${t(locale, 'navWork')} — ${siteMeta.name}`;
const lead = projectsByGroup('lead');
const other = projectsByGroup('other');
---

<Layout locale={locale} title={title} description={t(locale, 'workLead')}>
  <div class="site-frame">
    <Nav locale={locale} />
    <main class="page-shell flex-1 pb-24 pt-12 sm:pt-16">
      <p class="eyebrow reveal">{t(locale, 'workEyebrow')}</p>
      <h1
        class="hero-brand reveal reveal-delay-1 mt-4 text-[clamp(2.4rem,7vw,4rem)] font-extrabold"
      >
        {t(locale, 'navWork')}
      </h1>
      <p class="reveal reveal-delay-2 mt-4 max-w-xl text-muted">{t(locale, 'workLead')}</p>

      <h2 class="mt-14 font-display text-lg font-bold tracking-tight text-accent-deep sm:text-xl">
        {t(locale, 'workGroupLead')}
      </h2>
      <ul class="work-list mt-5">
        {
          lead.map((project) => (
            <li class="work-item">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="font-display text-2xl font-bold tracking-tight">{project.name}</h3>
                <p class="text-sm font-medium text-muted">{project.dates[locale]}</p>
              </div>
              <p class="mt-1 text-sm font-semibold text-accent-deep">{project.role[locale]}</p>
              <p class="mt-3 max-w-2xl leading-relaxed text-muted">{project.summary[locale]}</p>
              <ul class="mt-4 max-w-2xl list-disc space-y-1.5 pl-5 text-sm text-fg/85">
                {project.bullets[locale].map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              {project.href && (
                <a
                  class="mt-5 inline-flex text-sm font-semibold text-accent-deep underline-offset-4 hover:underline"
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {project.href.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <h2 class="mt-16 font-display text-lg font-bold tracking-tight text-accent-deep sm:text-xl">
        {t(locale, 'workGroupOther')}
      </h2>
      <ul class="work-list mt-5">
        {
          other.map((project) => (
            <li class="work-item">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="font-display text-2xl font-bold tracking-tight">{project.name}</h3>
                <p class="text-sm font-medium text-muted">{project.dates[locale]}</p>
              </div>
              <p class="mt-1 text-sm font-semibold text-accent-deep">{project.role[locale]}</p>
              <p class="mt-3 max-w-2xl leading-relaxed text-muted">{project.summary[locale]}</p>
              {project.href && (
                <a
                  class="mt-5 inline-flex text-sm font-semibold text-accent-deep underline-offset-4 hover:underline"
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {project.href.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </main>
    <Footer locale={locale} />
  </div>
</Layout>
