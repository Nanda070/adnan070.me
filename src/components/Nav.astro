---
import type { Locale } from '../i18n/ui';
import { t, withBase, switchLocalePath, locales } from '../i18n/ui';
import { siteMeta } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const home = withBase(base, locale);
const work = withBase(base, locale, 'work');
const resume = withBase(base, locale, 'resume');
const contact = withBase(base, locale, 'contact');
const langLinks = locales.map((code) => ({
  code,
  href: switchLocalePath(locale, code, path, base),
}));

const isActive = (href: string) => {
  const normalized = path.replace(/\/$/, '') || '/';
  const target = href.replace(/\/$/, '') || '/';
  return normalized === target;
};
---

<header class="topbar no-print">
  <nav class="page-shell topbar__in" aria-label={t(locale, 'navAria')}>
    <a href={home} class="brand">
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__name">{siteMeta.shortName}</span>
    </a>
    <div class="topbar__links">
      <a href={work} class="nav-link" aria-current={isActive(work) ? 'page' : undefined}
        >{t(locale, 'navWork')}</a
      >
      <a href={resume} class="nav-link" aria-current={isActive(resume) ? 'page' : undefined}
        >{t(locale, 'navResume')}</a
      >
      <a href={contact} class="nav-link" aria-current={isActive(contact) ? 'page' : undefined}
        >{t(locale, 'navContact')}</a
      >
    </div>
    <div class="topbar__end">
      <p class="clock">
        <span class="clock__city">{t(locale, 'clockLabel')}</span>
        <span class="clock__time" data-clock>--:--</span>
      </p>
      <div class="lang-switch" role="group" aria-label={t(locale, 'langSwitchAria')}>
        {
          langLinks.map((link) => (
            <a
              href={link.href}
              hreflang={link.code}
              lang={link.code}
              aria-current={locale === link.code ? 'page' : undefined}
            >
              {link.code.toUpperCase()}
            </a>
          ))
        }
      </div>
    </div>
  </nav>
</header>
