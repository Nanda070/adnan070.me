---
import { siteMeta } from '../data/site';
import type { Locale } from '../i18n/ui';
import { withBase } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
const four = withBase(import.meta.env.BASE_URL, locale, '404');
---

<footer class="site-footer no-print">
  <div
    class="page-shell flex flex-col gap-4 py-9 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="leading-relaxed">
      <span class="font-display text-base font-bold text-fg">{siteMeta.name}</span>
      <span class="mx-2 text-border">·</span>
      <span>{siteMeta.aka}</span>
      <span class="mx-2 text-border">·</span>
      © {year}
    </p>
    <div class="flex flex-wrap gap-x-5 gap-y-2">
      <a class="link-soft font-medium" href={siteMeta.githubHref} target="_blank" rel="noopener noreferrer"
        >GitHub</a
      >
      <a class="link-soft font-medium" href={siteMeta.telegramHref} target="_blank" rel="noopener noreferrer"
        >Telegram</a
      >
      <a class="link-soft font-medium" href={siteMeta.cardHref} target="_blank" rel="noopener noreferrer"
        >nanda.is-a.dev</a
      >
      <a class="link-soft font-medium" href={four}>404</a>
    </div>
  </div>
</footer>
