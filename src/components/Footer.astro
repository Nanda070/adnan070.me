---
import { siteMeta } from '../data/site';
import type { Locale } from '../i18n/ui';
import { withBase } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
const four = withBase(import.meta.env.BASE_URL, locale, '404');
---

<footer class="site-footer no-print">
  <div class="page-shell site-footer__in">
    <p class="site-footer__id">
      <span class="site-footer__name">{siteMeta.name}</span>
      <span class="site-footer__sep" aria-hidden="true"></span>
      <span>{siteMeta.aka}</span>
      <span class="site-footer__sep" aria-hidden="true"></span>
      <span>{year}</span>
    </p>
    <div class="site-footer__links">
      <a class="link-soft" href={siteMeta.githubHref} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="link-soft" href={siteMeta.telegramHref} target="_blank" rel="noopener noreferrer"
        >Telegram</a
      >
      <a class="link-soft" href={siteMeta.cardHref} target="_blank" rel="noopener noreferrer"
        >nanda.is-a.dev</a
      >
      <a class="link-soft" href={four}>404</a>
    </div>
  </div>
</footer>
