---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import { siteMeta, contacts } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const title = `${t(locale, 'navContact')} — ${siteMeta.name}`;
---

<Layout locale={locale} title={title} description={t(locale, 'contactLead')}>
  <div class="site-frame">
    <Nav locale={locale} />
    <main class="page-shell flex-1">
      <header class="page-head">
        <h1 class="page-head__title">{t(locale, 'navContact')}</h1>
        <p class="page-head__lead">{t(locale, 'contactLead')}</p>
      </header>

      <ul class="lines">
        {
          contacts.map((item) => (
            <li class="line">
              <p class="line__label">{item.label[locale]}</p>
              {item.href ? (
                <a
                  class="line__value"
                  href={item.href}
                  target={item.href.startsWith('http') ? '_blank' : undefined}
                  rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {item.value}
                </a>
              ) : (
                <p class="line__value">{item.value}</p>
              )}
              {item.copyValue && (
                <button type="button" class="copy-btn btn btn--ghost btn--small" data-copy={item.copyValue}>
                  <span class="copy-label">{t(locale, 'copy')}</span>
                </button>
              )}
            </li>
          ))
        }
      </ul>
    </main>
    <Footer locale={locale} />
  </div>
</Layout>

<script>
  const copiedByLang: Record<string, string> = { en: 'Copied', hu: 'Másolva', ru: 'Скопировано' };
  const copyByLang: Record<string, string> = { en: 'Copy', hu: 'Másolás', ru: 'Копировать' };
  const lang = document.documentElement.lang || 'en';

  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = value;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      const label = btn.querySelector('.copy-label');
      if (label) {
        label.textContent = copiedByLang[lang] ?? 'Copied';
        window.setTimeout(() => {
          label.textContent = copyByLang[lang] ?? 'Copy';
        }, 1400);
      }
    });
  });
</script>
