---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import { siteMeta, contacts } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const title = `${t(locale, 'navContact')} — ${siteMeta.name}`;
---

<Layout locale={locale} title={title} description={t(locale, 'contactLead')}>
  <div class="site-frame">
    <Nav locale={locale} />
    <main class="page-shell flex-1 pb-24 pt-12 sm:pt-16">
      <p class="eyebrow reveal">{t(locale, 'contactEyebrow')}</p>
      <h1 class="hero-brand reveal reveal-delay-1 mt-4 text-[clamp(2.4rem,7vw,4rem)] font-extrabold">
        {siteMeta.name}
      </h1>
      <p class="reveal reveal-delay-2 mt-4 max-w-xl text-muted">{t(locale, 'contactLead')}</p>

      <ul class="mt-10 grid gap-3">
        {
          contacts.map((item) => (
            <li class="contact-row flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="text-xs font-bold tracking-[0.14em] text-accent-deep uppercase">
                  {item.label[locale]}
                </p>
                {item.href ? (
                  <a
                    class="mt-1.5 block font-display text-2xl font-bold tracking-tight transition-colors hover:text-accent"
                    href={item.href}
                    target={item.href.startsWith('http') ? '_blank' : undefined}
                    rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    {item.value}
                  </a>
                ) : (
                  <p class="mt-1.5 font-display text-2xl font-bold tracking-tight">{item.value}</p>
                )}
              </div>
              {item.copyValue && (
                <button type="button" class="copy-btn btn-ghost self-start text-xs" data-copy={item.copyValue}>
                  <span class="copy-label">{t(locale, 'copy')}</span>
                </button>
              )}
            </li>
          ))
        }
      </ul>
    </main>
    <Footer locale={locale} />
  </div>
</Layout>

<script>
  const copiedByLang: Record<string, string> = { en: 'Copied', ru: 'Скопировано' };
  const copyByLang: Record<string, string> = { en: 'Copy', ru: 'Копировать' };
  const lang = document.documentElement.lang || 'en';

  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = value;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      const label = btn.querySelector('.copy-label');
      if (label) {
        label.textContent = copiedByLang[lang] ?? 'Copied';
        window.setTimeout(() => {
          label.textContent = copyByLang[lang] ?? 'Copy';
        }, 1400);
      }
    });
  });
</script>
