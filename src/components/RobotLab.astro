    pick(e); const hit = ray.intersectObjects(pillars, false)[0];
    const m = hit ? hit.object : null;
    if (m !== hover) { hover && hover.userData.label.classList.remove('hot'); hover = m; hover && hover.userData.label.classList.add('hot'); canvas.classList.toggle('hov', !!m); }
  });
  canvas.addEventListener('pointerdown', e => { downAt = [e.clientX, e.clientY]; });
  canvas.addEventListener('pointerup', e => {
    if (!downAt || Math.hypot(e.clientX - downAt[0], e.clientY - downAt[1]) > 8) return;
    pick(e);
    const hit = ray.intersectObjects(pillars, false)[0];
    if (hit) { openProject(hit.object.userData.p.id); return; }
    const g = ray.intersectObject(ground)[0];
    if (g) { target = { x: g.point.x, z: g.point.z }; marker.position.x = g.point.x; marker.position.z = g.point.z; marker.visible = true; }
  });
  $('#prompt-b').addEventListener('click', () => near && openProject(near.userData.p.id));

  /* minimap */
  const mm = $('#minimap'), mx = mm.getContext('2d');
  function drawMap() {
    const W = mm.width, s = W / 64, c = W / 2;
    mx.clearRect(0, 0, W, W);
    ZONES.forEach((z, i) => { mx.beginPath(); mx.arc(c + z.x * s, c + z.z * s, z.r * s, 0, 7); mx.strokeStyle = z.hero ? V('--flare') : i % 2 ? V('--cool') : V('--accent'); mx.lineWidth = 3; mx.globalAlpha = z === curZone ? 1 : .45; mx.stroke(); });
    mx.globalAlpha = 1; mx.fillStyle = V('--muted'); pillars.forEach(p => mx.fillRect(c + p.position.x * s - 3, c + p.position.z * s - 3, 6, 6));
    mx.save(); mx.translate(c + st.x * s, c + st.z * s); mx.rotate(-st.h); mx.fillStyle = V('--fg');
    mx.beginPath(); mx.moveTo(0, 14); mx.lineTo(-9, -8); mx.lineTo(9, -8); mx.closePath(); mx.fill(); mx.restore();
  }

  /* loop */
  let near = null, last = performance.now();
  const prompt = $('#prompt'), promptT = $('#prompt-t');
  const camPos = new THREE.Vector3(0, 14, 14), look = new THREE.Vector3();
  let zoom = 1;
  canvas.addEventListener('wheel', e => { e.preventDefault(); zoom = Math.max(.55, Math.min(1.8, zoom * (1 + e.deltaY * .0012))); }, { passive: false });
  const v3 = new THREE.Vector3();
  function wrap(a) { while (a > Math.PI) a -= Math.PI * 2; while (a < -Math.PI) a += Math.PI * 2; return a; }
  let frameN = 0, fpsAvg = 16, prevNow = performance.now(), qualityAt = performance.now() + 3000;
  const fpsEl = /[?&]fps\b/.test(location.search) ? document.body.appendChild(Object.assign(document.createElement('div'), { className: 'mono', style: 'position:fixed;z-index:9;left:50%;top:8px;transform:translateX(-50%);color:var(--fg)' })) : null;
  function frame(now) {
    const dt = Math.min(.05, (now - last) / 1000); last = now; const t = now / 1000;
    if (!paused) {
      // direct, screen-relative movement (camera looks north, so "up" on screen is -z)
      let ix = 0, iz = 0, want = 0;
      if (keys.has('w') || keys.has('arrowup')) iz -= 1;
      if (keys.has('s') || keys.has('arrowdown')) iz += 1;
      if (keys.has('a') || keys.has('arrowleft')) ix -= 1;
      if (keys.has('d') || keys.has('arrowright')) ix += 1;
      if (ix || iz) { const m = Math.hypot(ix, iz); ix /= m; iz /= m; want = 1; }
      else if (joy.id !== null && joy.m > .12) { const m = Math.hypot(joy.x, joy.y) || 1; ix = joy.x / m; iz = joy.y / m; want = Math.min(1, (joy.m - .12) / .75); }
      else if (target) {
        const dx = target.x - st.x, dz = target.z - st.z, dist = Math.hypot(dx, dz);
        if (dist > .4) { ix = dx / dist; iz = dz / dist; want = Math.min(1, dist / 1.5 + .2); }
        else { target = null; marker.visible = false; auto = false; if (near) st.face = Math.atan2(near.position.x - st.x, near.position.z - st.z); }
      }
      const sprint = keys.has('shift') || sprintLatch || auto || (joy.id !== null && joy.m > .92);
      const top = sprint ? 16 : 8;
      const acc = 1 - Math.exp(-dt * (st.air ? 2.5 : want ? 10 : 13));
      st.vx += (ix * want * top - st.vx) * acc; st.vz += (iz * want * top - st.vz) * acc;
      st.x += st.vx * dt; st.z += st.vz * dt;
      st.v = Math.hypot(st.vx, st.vz);
      const faceTo = st.v > .4 ? Math.atan2(st.vx, st.vz) : (st.face ?? st.h);
      if (st.v > .4) st.face = null;
      const dh = wrap(faceTo - st.h); st.h = wrap(st.h + dh * (1 - Math.exp(-dt * 16)));
      const turn = Math.max(-1, Math.min(1, dh * 2));
      st.x = Math.max(-40, Math.min(40, st.x)); st.z = Math.max(-40, Math.min(40, st.z));
      if (!st.air) pillars.forEach(p => { const dx = st.x - p.position.x, dz = st.z - p.position.z, d = Math.hypot(dx, dz); const R = p.userData.rad; if (d < R && d > 0) { st.x = p.position.x + dx / d * R; st.z = p.position.z + dz / d * R; st.vx *= .5; st.vz *= .5; } });
      // jump + flip
      if (st.air) {
        st.vy -= GRAV * dt; st.y += st.vy * dt;
        const airTime = 2 * 9.5 / GRAV; st.flip = Math.min(1, st.flip + dt / airTime);
        if (st.y <= 0) { st.y = 0; st.vy = 0; st.air = false; st.flip = 0; st.land = 1; puff(st.x, st.z, 10, 1); buzz(25); }
      }
      st.land = Math.max(0, st.land - dt * 5);
      const e = st.flip < .5 ? 2 * st.flip * st.flip : 1 - Math.pow(-2 * st.flip + 2, 2) / 2;
      const speedK = Math.min(1, Math.abs(st.v) / 8.5);
      robot.position.set(st.x, st.y, st.z);
      robot.rotation.y = st.h;
      rig.rotation.x = st.air ? st.flipDir * e * Math.PI * 2 : (reduce ? 0 : (sprint ? .22 : .08) * speedK);
      rig.rotation.z = reduce ? 0 : -turn * speedK * .08;
      rig.scale.set(1 + st.land * .12, 1 - st.land * .18, 1 + st.land * .12);
      // walk cycle
      st.phase += Math.abs(st.v) * dt * 1.25;
      const amp = st.air ? 0 : Math.min(.9, .25 + speedK * (sprint ? .75 : .5));
      legs.forEach((L, i) => {
        const s = Math.sin(st.phase + i * Math.PI);
        L.hip.rotation.x = st.air ? -.7 : s * amp * (Math.abs(st.v) > .3 ? 1 : 0);
        L.knee.rotation.x = st.air ? 1.3 : Math.max(0, -Math.cos(st.phase + i * Math.PI)) * amp * 1.3 * (Math.abs(st.v) > .3 ? 1 : 0);
      });
      arms.forEach((A, i) => { A.rotation.x = st.air ? -2.4 : -Math.sin(st.phase + i * Math.PI) * amp * .9; A.rotation.z = (i ? -1 : 1) * (st.air ? .5 : .08); });
      rig.position.y = 1.05 + (Math.abs(st.v) > .3 && !st.air && !reduce ? Math.abs(Math.sin(st.phase)) * .06 : 0);
      headG.rotation.y = reduce ? 0 : Math.sin(t * .8) * .35 * (Math.abs(st.v) < .5 ? 1 : 0);
      headG.rotation.x = !reduce && Math.abs(st.v) < .5 ? Math.sin(t * 1.3) * .05 : 0;
      const blink = (t % 3.2) < .12 ? .1 : 1; eyes.forEach(m => m.scale.y = blink);
      bulbs.forEach(b => b.visible = Math.sin(t * 5) > -.3);
      if (sprint && !st.air && Math.abs(st.v) > 6 && Math.random() < dt * 30) puff(st.x - Math.sin(st.h) * .6, st.z - Math.cos(st.h) * .6, 1, .4);
      dust.forEach(d => { if (d.life <= 0) return; d.life -= dt * 1.6; d.m.position.x += d.vx * dt; d.m.position.y += d.vy * dt; d.m.position.z += d.vz * dt; d.m.scale.setScalar(.6 + (1 - d.life) * 1.1); d.m.material.opacity = Math.max(0, d.life) * .45; if (d.life <= 0) d.m.visible = false; });
      lidar.position.x = st.x; lidar.position.z = st.z;
      const lp = reduce ? .5 : (t * .7) % 1; lidar.scale.setScalar(1 + lp * 3.5); lidar.material.opacity = .6 * (1 - lp);
      marker.rotation.z = t * 2;
      // zone + nearest pillar
      const z = ZONES.find(z => Math.hypot(st.x - z.x, st.z - z.z) < z.r + .6) || null;
      setZone(z);
      ZONES.forEach(zz => { zz.ring.material.opacity = zz === z ? 1 : .5; if (zz.beacon) zz.beacon.visible = Math.sin(t * 3) > 0; });
      let best = null, bd = 2.4;
      pillars.forEach(p => { const d = Math.hypot(st.x - p.position.x, st.z - p.position.z) - (p.userData.rad - 1.35); if (p.userData.beacon) p.userData.beacon.position.y = p.userData.h / 2 + .7 + (reduce ? 0 : Math.sin(t * 2) * .15); if (d < bd) { bd = d; best = p; } p.userData.cap.position.y = p.userData.h / 2 + .06 + (reduce ? 0 : Math.sin(t * 2 + p.position.x) * .04); });
      if (best !== near) { near && near.userData.label.classList.remove('hot'); near = best; near && near.userData.label.classList.add('hot'); prompt.hidden = !near; if (near) promptT.textContent = near.userData.p.title; }
      // camera follow
      const camH = (innerWidth < 700 ? 17 : 13) * zoom, camB = (innerWidth < 700 ? 15 : 12) * zoom;
      camPos.set(st.x, camH + st.y * .35, st.z + camB);
      camera.position.lerp(camPos, 1 - Math.exp(-dt * 7));
      camera.lookAt(camera.position.x, camera.position.y - camH, camera.position.z - camB - 2);
      const sx = Math.round(st.x / 4) * 4, sz = Math.round(st.z / 4) * 4;
      if (sx !== sun.userData.sx || sz !== sun.userData.sz) { sun.userData.sx = sx; sun.userData.sz = sz; sun.position.set(sx + 14, 26, sz + 10); sun.target.position.set(sx, 0, sz); }
      renderer.render(scene, camera);
      // labels
      labelItems.forEach(it => {
        v3.copy(it.pos).project(camera);
        const vis = v3.z < 1 && Math.abs(v3.x) < 1.2 && Math.abs(v3.y) < 1.2;
        const dist = it.pillar ? Math.hypot(st.x - it.pillar.position.x, st.z - it.pillar.position.z) : 0;
        const show = vis && (!it.pillar || dist < 9 || it.el.classList.contains('hot'));
        if (show !== it.shown) { it.shown = show; it.el.style.visibility = show ? 'visible' : 'hidden'; }
        if (show) {
          const x = Math.round((v3.x * .5 + .5) * innerWidth), y = Math.round((-v3.y * .5 + .5) * innerHeight);
          if (x !== it.x || y !== it.y) { it.x = x; it.y = y; it.el.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -100%)`; }
        }
      });
      if ((frameN++ & 1) === 0) drawMap();
      // adaptive quality: if frames are slow for ~2 s, drop resolution, then shadows
      fpsAvg += ((now - prevNow) - fpsAvg) * .05; prevNow = now;
      if (now - qualityAt > 2000 && fpsAvg > 24) {
        qualityAt = now;
        if (pr > 1) { pr = 1; renderer.setPixelRatio(pr); renderer.setSize(innerWidth, innerHeight, false); }
        else if (sun.castShadow) { sun.castShadow = false; }
      }
      if (fpsEl) fpsEl.textContent = Math.round(1000 / fpsAvg) + ' fps · pr ' + pr + (sun.castShadow ? ' · shadows' : '');
    }
    requestAnimationFrame(frame);
  }
  labelItems.forEach(it => { it.el.style.left = '0'; it.el.style.top = '0'; it.el.style.willChange = 'transform'; });
  addEventListener('resize', () => { renderer.setSize(innerWidth, innerHeight, false); camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); });
  camera.position.set(0, reduce ? 13 : 30, reduce ? 14.2 : 30);
  requestAnimationFrame(frame);
})();
</script>

