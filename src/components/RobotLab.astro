---
/*
 * Robot Lab: the home page of adnan070.me (/, /ru, /hu).
 * Forked from "Robot Lab Portfolio" (index.html) by Yousef Mohammed Abdelkareem,
 * https://github.com/yousefJooX/robot-lab-portfolio — MIT License, Copyright (c) 2026 Yousef Mohammed Abdelkareem.
 * Changes: Adnan's projects and palette, data built from src/data at build time, Val Qauym hero zone, voice removed.
 * Line figures: hairline 0.5.0 by Lucas Markes (MIT), see /lab/vendor/hairline.LICENSE.
 */
import type { Locale } from '../i18n/ui';
import { locales, withBase, ogLocale } from '../i18n/ui';
import { labDataScript, labUi } from '../data/lab';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const L = labUi[locale];
const base = import.meta.env.BASE_URL;
const site = 'https://adnan070.me';
const labUrl = (code: Locale) => new URL(withBase(base, code), site).href;
const resume = withBase(base, locale, 'resume');
const classic = withBase(base, locale, 'about');
---
<!doctype html>
<html lang={locale}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#060913">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Adnan Huseynli">
<meta property="og:title" content={L.title}>
<meta property="og:description" content={L.ogDescription}>
<meta property="og:url" content={labUrl(locale)}>
<meta property="og:locale" content={ogLocale[locale]}>
<meta name="twitter:card" content="summary">
<meta name="description" content={L.description}>
<link rel="canonical" href={labUrl(locale)}>
{locales.map((code) => <link rel="alternate" hreflang={code} href={labUrl(code)} />)}
<link rel="alternate" hreflang="x-default" href={labUrl('en')}>
<style is:inline>html,body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
<title>{L.title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;800&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
<style is:inline>
/* Layout: a drivable 3D robotics lab. Zones on the floor are project categories; each project is a pillar.
   HTML panels (zone list, case study) slide over the WebGL scene. */
:root {
  --bg: #060913;
  --surface: #0c1222;
  --surface-2: #111a30;
  --line: #1f2a47;
  --fg: #e9eefc;
  --muted: #8793b3;
  --accent: #7c9bff;
  --accent-ink: #060913;
  --cool: #5bf5b0;
  --flare: #ff6b9a;
  --display: "Unbounded", "Segoe UI", system-ui, sans-serif;
  --body: "Hanken Grotesk", "Segoe UI", system-ui, sans-serif;
  --mono: "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace;
  color-scheme: dark;
}
*, *::before, *::after { box-sizing: border-box; }
html, body { height: 100%; }
body { background: var(--bg); color: var(--fg); font-family: var(--body); font-size: 15px; line-height: 1.55; overflow: hidden; }
a { color: inherit; }
button { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
h1, h2, h3, h4, p { margin: 0; }
.mono { font-family: var(--mono); font-size: .72rem; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); }
.disp { font-family: var(--display); font-weight: 800; text-transform: uppercase; line-height: 1; letter-spacing: -.01em; }
.disp span, .accent { color: var(--accent); }
#scene { position: fixed; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; cursor: crosshair; }
#scene.hov { cursor: pointer; }

/* HUD */
.hud-tl { position: fixed; z-index: 5; top: calc(14px + env(safe-area-inset-top, 0px)); left: 16px; display: grid; gap: 4px; pointer-events: none; }
.hud-tl .disp { font-size: 1.05rem; }
.hud-tl .disp span { color: var(--accent); }
.zone-now { font-family: var(--mono); font-size: .8rem; color: var(--fg); }
.zone-now b { color: var(--accent); font-weight: 500; }
.hud-tl .lang { display: flex; gap: 4px; margin-top: 4px; pointer-events: auto; }
.hud-tl .lang .tbtn { padding: 5px 9px; }
.hud-tl .lang .tbtn.on { border-color: var(--accent); color: var(--accent); }
.hud-tr .row { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; max-width: min(440px, calc(100vw - 32px)); }
.whatdid { margin: 0; padding-left: 18px; display: grid; gap: 8px; color: var(--muted); }
.hud-tr { position: fixed; z-index: 5; top: calc(14px + env(safe-area-inset-top, 0px)); right: 16px; display: grid; gap: 8px; justify-items: end; }
#minimap { width: 150px; height: 150px; border-radius: 12px; border: 1px solid var(--line); background: rgba(6,9,19,.7); backdrop-filter: blur(8px); display: block; }
.tbtn { display: inline-flex; gap: 8px; align-items: center; padding: 9px 14px; border-radius: 999px; border: 1px solid var(--line); background: rgba(12,18,34,.8); backdrop-filter: blur(8px); cursor: pointer; font: 500 .74rem var(--mono); text-transform: uppercase; letter-spacing: .06em; text-decoration: none; }
.tbtn:hover { border-color: var(--accent); color: var(--accent); }
.tbtn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
.hud-bl { position: fixed; z-index: 5; left: 16px; bottom: calc(14px + env(safe-area-inset-bottom, 0px)); display: flex; gap: 6px; flex-wrap: wrap; align-items: center; pointer-events: none; }
.key { font: 500 .7rem var(--mono); padding: 4px 8px; border: 1px solid var(--line); border-bottom-width: 3px; border-radius: 6px; background: var(--surface); }
@media (max-width: 700px) { #minimap { width: 110px; height: 110px; } .hud-bl .k-desk { display: none; } }

.k-touch { display: none; }
.touch, .joy { display: none; }
.joy { position: fixed; z-index: 6; left: 18px; bottom: calc(22px + env(safe-area-inset-bottom, 0px)); width: 132px; height: 132px; border-radius: 50%;
  background: rgba(12,18,34,.55); border: 1px solid var(--line); backdrop-filter: blur(6px); touch-action: none; }
.joy::before { content: ""; position: absolute; inset: 22%; border-radius: 50%; border: 1px dashed var(--line); }
.joy .knob { position: absolute; left: 50%; top: 50%; width: 58px; height: 58px; margin: -29px 0 0 -29px; border-radius: 50%; background: var(--fg); box-shadow: 0 6px 18px rgba(0,0,0,.5); transition: background .15s; }
.joy.run .knob { background: var(--accent); }
.touch { position: fixed; z-index: 6; right: 16px; bottom: calc(22px + env(safe-area-inset-bottom, 0px)); width: 150px; height: 140px; }
.touch button { position: absolute; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--line); background: rgba(12,18,34,.8); backdrop-filter: blur(8px); cursor: pointer; touch-action: manipulation; font-size: 1.3rem; line-height: 1; }
.touch button small { display: block; font: 600 .55rem var(--mono); letter-spacing: .06em; text-transform: uppercase; margin-top: 2px; }
.touch #t-jump { right: 0; bottom: 0; width: 82px; height: 82px; background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-size: 1.7rem; }
.touch #t-run { left: 0; bottom: 6px; width: 58px; height: 58px; }
.touch #t-next { right: 12px; top: 0; width: 52px; height: 52px; }
.touch button:active { transform: scale(.92); }
.touch #t-run.on { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
.joy, .touch, .touch * { user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
.ph { all: unset; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 10px; align-items: end; cursor: pointer; }
.ph > .mono, .ph > .disp { grid-column: 1; }
.ph .chev { display: none; grid-row: 1 / span 2; grid-column: 2; align-self: center; color: var(--accent); font-size: 1.1rem; transition: transform .2s; }
.pb { display: grid; gap: 12px; }
@media (hover: none), (pointer: coarse) {
  .joy { display: block; } .touch { display: block; } .k-touch { display: inline; } .k-desk { display: none !important; }
  .hud-bl { display: none; }
  body #minimap { width: 92px; height: 92px; }
  body .prompt { bottom: calc(176px + env(safe-area-inset-bottom, 0px)); }
  body .panel { top: auto; left: 12px; right: 12px; width: auto; bottom: calc(232px + env(safe-area-inset-bottom, 0px)); max-height: 40%; padding: 12px 14px; gap: 10px; }
  body .panel h2 { font-size: 1.1rem; }
  .ph .chev { display: block; }
  .panel.collapsed .pb { display: none; }
  .panel:not(.collapsed) .chev { transform: rotate(180deg); }
}
.hud-toast { position: fixed; z-index: 6; left: 50%; top: calc(70px + env(safe-area-inset-top, 0px)); transform: translateX(-50%); padding: 8px 16px; border-radius: 999px; background: var(--accent); color: var(--accent-ink); font: 600 .85rem var(--body); white-space: nowrap; max-width: calc(100% - 32px); overflow: hidden; text-overflow: ellipsis; }
/* hairline figure in the case study */
.case-head { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 28px; align-items: center; }
.case-figwrap { margin: 0; width: 100%; max-width: 420px; justify-self: end; display: grid; gap: 6px; }
.case-fig { width: 100%; max-width: 100%;
  --hairline-plate: #060913; --hairline-hi: #e9eefc; --hairline-edge: #7c9bff; --hairline-mid: #4d5b85; --hairline-lo: #1f2a47; --hairline-stroke: 1; }
.case-figwrap figcaption { text-align: right; color: var(--accent); min-height: 1.2em; }
@media (max-width: 760px) { .case-head { grid-template-columns: minmax(0, 1fr); } .case-figwrap { justify-self: center; max-width: 340px; } }
/* floating labels */
.labels { position: fixed; inset: 0; pointer-events: none; z-index: 3; }
.zl { position: absolute; transform: translate(-50%, -100%); text-align: center; white-space: nowrap; }
.zl .n { font-family: var(--display); font-weight: 800; font-size: 1rem; text-transform: uppercase; line-height: 1; text-shadow: 0 2px 14px #000; }
.zl .c { font: 500 .66rem var(--mono); color: var(--accent); letter-spacing: .08em; text-transform: uppercase; }
.pl { position: absolute; transform: translate(-50%, -100%); font: 500 .68rem var(--mono); padding: 3px 8px; border-radius: 4px; background: rgba(6,9,19,.85); border: 1px solid var(--line); white-space: nowrap; transition: background .15s, color .15s; }
.pl.hot { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }

/* prompt */
.prompt { position: fixed; z-index: 6; left: 50%; bottom: calc(58px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); display: flex; gap: 10px; align-items: center; padding: 10px 12px 10px 16px; border-radius: 999px; background: rgba(12,18,34,.92); border: 1px solid var(--accent); max-width: calc(100% - 32px); }
.prompt span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; font-weight: 600; }

/* zone panel */
.panel { position: fixed; z-index: 7; right: 16px; top: 216px; width: min(360px, calc(100% - 32px)); max-height: calc(100% - 296px); overflow: auto; padding: 18px; border-radius: 14px; background: rgba(12,18,34,.88); backdrop-filter: blur(14px); border: 1px solid var(--line); display: grid; gap: 12px; }
.panel h2 { font-size: 1.35rem; }
.panel p { color: var(--muted); font-size: .9rem; }
.plist { display: grid; gap: 6px; }
.pitem { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: center; text-align: left; padding: 10px 12px; border-radius: 9px; border: 1px solid var(--line); background: var(--surface-2); cursor: pointer; }
.pitem:hover, .pitem:focus-visible { border-color: var(--accent); }
.pitem b { display: block; font-weight: 600; font-size: .92rem; line-height: 1.25; }
.pitem small { font: .66rem var(--mono); color: var(--cool); text-transform: uppercase; letter-spacing: .06em; }
.pitem .v { font-family: var(--display); font-weight: 600; font-size: .85rem; white-space: nowrap; color: var(--accent); }
.links { display: flex; flex-wrap: wrap; gap: 6px; }
.jl { display: grid; gap: 10px; }
.jl div { padding-left: 12px; border-left: 2px solid var(--accent); }
.jl b { display: block; font-weight: 600; }
.jl span { font-size: .84rem; color: var(--muted); }
@media (max-width: 700px) { .panel { top: auto; bottom: calc(76px + env(safe-area-inset-bottom, 0px)); right: 12px; left: 12px; width: auto; max-height: 42%; } }

/* intro */
.intro { position: fixed; inset: 0; z-index: 20; display: grid; place-items: center; padding: 16px; background: radial-gradient(circle at 50% 40%, rgba(6,9,19,.55), rgba(6,9,19,.92)); }
.intro-card { max-width: 560px; display: grid; gap: 18px; text-align: center; justify-items: center; }
.intro h1 { font-size: clamp(2rem, 8.5vw, 4.4rem); }
.intro h1 span { color: var(--accent); }
.intro p { color: var(--muted); max-width: 46ch; }
.intro .keys { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }
.intro .keys.k-touch { display: none; }
@media (hover: none), (pointer: coarse) { .intro .keys.k-touch { display: flex; } }

/* modal (case + list) */
.modal { position: fixed; inset: 0; z-index: 30; overflow: auto; overscroll-behavior: contain; background: rgba(6,9,19,.97); backdrop-filter: blur(16px); }
.modal-in { max-width: 1040px; margin-inline: auto; padding: calc(16px + env(safe-area-inset-top, 0px)) 16px calc(48px + env(safe-area-inset-bottom, 0px)); display: grid; gap: 28px; }
.mbar { position: sticky; top: 0; z-index: 2; display: flex; justify-content: space-between; gap: 10px; align-items: center; padding-block: 10px; background: linear-gradient(rgba(6,9,19,1) 70%, transparent); }
.btn { display: inline-flex; align-items: center; gap: 10px; padding: 12px 20px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface-2); text-decoration: none; cursor: pointer; font: 600 .9rem var(--body); }
.btn:hover { border-color: var(--accent); }
.btn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
.row-btns { display: flex; flex-wrap: wrap; gap: 8px; }
.case h2 { font-size: clamp(1.7rem, 5vw, 3.2rem); overflow-wrap: anywhere; }
.case .summary { font-size: 1.05rem; max-width: 64ch; }
.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); border-block: 1px solid var(--line); }
.kpi { padding: 16px 12px 16px 0; display: grid; gap: 4px; min-width: 0; }
.kpi b { font-family: var(--display); font-weight: 600; font-size: 1.45rem; line-height: 1; color: var(--accent); overflow-wrap: anywhere; }
.sub { font-family: var(--display); font-weight: 800; font-size: 1.15rem; text-transform: uppercase; margin-bottom: 14px; }
.cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 36px; align-items: start; }
.flow { list-style: none; margin: 0; padding: 0 0 0 30px; position: relative; display: grid; }
.flow::before { content: ""; position: absolute; left: 5px; top: 8px; bottom: 8px; width: 1px; background: linear-gradient(var(--accent), var(--cool)); }
.flow li { position: relative; padding-bottom: 16px; }
.flow li::before { content: ""; position: absolute; left: -30px; top: 5px; width: 11px; height: 11px; border-radius: 3px; border: 2px solid var(--accent); background: var(--bg); }
.flow h4 { font-family: var(--display); font-weight: 600; font-size: .9rem; text-transform: uppercase; line-height: 1.1; }
.flow p { color: var(--muted); font-size: .92rem; }
.notes { margin: 0; padding: 0; display: grid; gap: 10px; }
.notes li { list-style: none; position: relative; padding-left: 20px; font-size: .93rem; }
.notes li::before { content: "▸"; position: absolute; left: 0; color: var(--cool); }
.chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0; }
.chips li { list-style: none; font: .72rem var(--mono); padding: 4px 10px; border-radius: 999px; border: 1px solid var(--line); }
.bars { display: grid; gap: 8px; }
.bar-row { display: grid; grid-template-columns: minmax(0, 96px) minmax(0, 1fr) 54px; gap: 10px; align-items: center; font-size: .84rem; }
.trk { height: 8px; background: var(--surface-2); border-radius: 999px; overflow: hidden; }
.fill { display: block; height: 100%; background: var(--cool); border-radius: 999px; }
.bar-row.best .fill { background: var(--accent); }
.bar-row .v { font: 500 .74rem var(--mono); text-align: right; }
.bar-row.best .v, .bar-row.best .l { color: var(--accent); }
.status { font: 500 .72rem var(--mono); text-transform: uppercase; color: var(--accent); }
.listgrid { display: grid; gap: 28px; }
.listgrid h3 { font-family: var(--display); font-weight: 800; font-size: 1.05rem; text-transform: uppercase; margin-bottom: 10px; color: var(--accent); }
.listgrid .plist { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
.noscene { position: fixed; inset: 0; display: grid; place-items: center; padding: 24px; text-align: center; color: var(--muted); }
</style>
</head>
<body>

<canvas id="scene" aria-label={L.sceneLabel}></canvas>
<div class="labels" id="labels" aria-hidden="true"></div>

<div class="hud-tl">
  <span class="disp">Adnan <span>Robot Lab</span></span>
  <span class="zone-now" id="zone-now">{L.zone} · <b>{L.zoneNames.start.toLowerCase()}</b></span>
  <div class="row lang">
    {locales.map((code) => (
      <a class:list={['tbtn', code === locale && 'on']} href={withBase(base, code)} hreflang={code} lang={code} aria-current={code === locale ? 'page' : undefined}>{code.toUpperCase()}</a>
    ))}
  </div>
</div>
<div class="hud-tr">
  <canvas id="minimap" width="300" height="300" aria-hidden="true"></canvas>
  <div class="row">
    <button class="tbtn" type="button" id="open-list">{L.allProjects} ☰</button>
    <a class="tbtn" href={classic}>{L.classic} ↗</a>
    <a class="tbtn primary" href={resume}>{L.resume} ↗</a>
  </div>
</div>
<div class="hud-bl" aria-hidden="true">
  <span class="key k-desk">WASD</span><span class="mono k-desk">{L.move}</span>
  <span class="key k-desk">Shift</span><span class="mono k-desk">{L.sprint}</span>
  <span class="key k-desk">Space</span><span class="mono k-desk">{L.jumpFlip}</span>
  <span class="key k-desk">Tab</span><span class="mono k-desk">{L.runNext}</span>
  <span class="key k-desk">1–8</span><span class="mono k-desk">{L.zones}</span>
  <span class="key k-desk">E</span><span class="mono k-desk">{L.open}</span>
  <span class="key k-desk">Scroll</span><span class="mono k-desk">{L.zoom}</span>
  <span class="mono k-touch">{L.tapFloor}</span>
</div>
<div class="joy" id="joy" aria-label={L.joyLabel}><div class="knob"></div></div>
<div class="touch" aria-label={L.controlsLabel}>
  <button type="button" id="t-next" aria-label={L.nextLabel}>⏭</button>
  <button type="button" id="t-run" aria-label={L.runLabel}>⚡<small>{L.run}</small></button>
  <button type="button" id="t-jump" aria-label={L.jumpLabel}>⤴</button>
</div>
<div class="hud-toast" id="hud-toast" hidden></div>

<div class="prompt" id="prompt" hidden><span id="prompt-t"></span><button class="tbtn primary" type="button" id="prompt-b">{L.openE}</button></div>
<aside class="panel" id="panel" aria-live="polite"></aside>

<div class="intro" id="intro">
  <div class="intro-card">
    <span class="mono">{L.introKicker}</span>
    <h1 class="disp">Adnan <span>Robot Lab</span></h1>
    <p set:html={L.introText} />
    <div class="keys k-desk">{L.keysDesk.map((k) => <span class="key">{k}</span>)}</div>
    <div class="keys k-touch">{L.keysTouch.map((k) => <span class="key">{k}</span>)}</div>
    <div class="row-btns" style="justify-content:center">
      <button class="btn primary" type="button" id="start">{L.start}</button>
      <button class="btn" type="button" id="skip">{L.skip}</button>
      <a class="btn" href={classic}>{L.classic}</a>
      <a class="btn" href={resume}>{L.resume} ↗</a>
    </div>
  </div>
</div>

<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="m-title" hidden>
  <div class="modal-in">
    <div class="mbar"><span class="mono" id="m-pos"></span><div class="row-btns"><button class="btn" type="button" id="m-close">{L.back} ✕</button></div></div>
    <div id="m-body"></div>
  </div>
</div>

<script is:inline set:html={labDataScript(locale, base)}></script>
<script is:inline type="module">
  import * as Hairline from '/lab/vendor/hairline-0.5.0.js';
  window.Hairline = Hairline; dispatchEvent(new Event('hairline-ready'));
</script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline>
(() => {
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const pad = n => String(n).padStart(2, '0');
  const pluralRules = new Intl.PluralRules(document.documentElement.lang);
  const plural = n => (UI.plural[pluralRules.select(n)] || UI.plural.other).replace('{n}', n);
  const $ = s => document.querySelector(s);
  const css = getComputedStyle(document.documentElement), V = n => css.getPropertyValue(n).trim();

  /* ---------- case study ---------- */
  function caseHTML(p) {
    const kpis = p.kpis.map(([v, l]) => `<div class="kpi"><b>${esc(v)}</b><span class="mono">${esc(l)}</span></div>`).join('');
    const flow = p.flow.map(([h, d]) => `<li><h4>${esc(h)}</h4><p>${esc(d)}</p></li>`).join('');
